/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "paths": {
      "toolkit": ["./dist/toolkit"],
      "dynamic-view": ["./dist/dynamic-view"],
      "dynamic-view-test": ["./dist/dynamic-view-test"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  },
  "files": [],
  "references": [
    {
      "path": "./workspace/rw-webui/tsconfig.app.json"
    },
    {
      "path": "./workspace/rw-webui/tsconfig.spec.json"
    },
    {
      "path": "./workspace/toolkit/tsconfig.lib.json"
    },
    {
      "path": "./workspace/toolkit/tsconfig.spec.json"
    },
    {
      "path": "./workspace/dynamic-view/tsconfig.lib.json"
    },
    {
      "path": "./workspace/dynamic-view/tsconfig.spec.json"
    },
    {
      "path": "./workspace/dynamic-view-test/tsconfig.lib.json"
    },
    {
      "path": "./workspace/dynamic-view-test/tsconfig.spec.json"
    }
  ]
}
